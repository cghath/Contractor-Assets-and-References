  "doctrine": {
    "summary": "Compact, high-readiness army re-orienting to littoral manoeuvre in the Indo-Pacific under the 2023 Defence Strategic Review: long-range fires (HIMARS), amphibious operations from Canberra-class LHDs, armoured cavalry on Boxer CRV, and Abrams tanks. Strong special-forces and counter-terror heritage from Afghanistan and Iraq.",
    "squad_size": 8,
    "fireteam": "Infantry section of 8: section commander, 2IC, scout group and gun group(s) with Minimi/Maximi; pairs within each group.",
    "tactics": [
      "Section fire and movement with gun group suppression",
      "Jungle patrolling, ambush and counter-ambush drills",
      "Amphibious insertion from LHD by landing craft and helicopter",
      "Mounted patrols in Bushmaster; Hawkei for liaison and recce",
      "Combined-arms teams pairing Abrams with infantry in close country"
    ],
