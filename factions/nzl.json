  "doctrine": {
    "summary": "Small light-infantry army optimised for Pacific stabilisation, peacekeeping and coalition niches (Afghanistan PRT Bamyan, Iraq training at Taji, UNTSO observers, UN Command Korea). Motorised by Bushmasters, NZLAVs and MRZRs; relies on allies (mainly Australia) for heavy fires and air.",
    "squad_size": 8,
    "fireteam": "Section of 8 in two fireteams of four, each with a MAG 58 or marksman element; pairs within teams.",
    "tactics": [
      "Light-infantry fire and movement, jungle patrolling",
      "Community engagement and restrained use of force (peace-support heritage)",
      "Bushmaster-mounted patrols; MRZR for light, fast SOF-style movement",
      "NZSAS small-team raids with high night capability"
    ],
