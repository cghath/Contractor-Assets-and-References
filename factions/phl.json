  "doctrine": {
    "summary": "Armed Forces of the Philippines shifting from decades of internal security (communist NPA insurgency and Islamist groups in Mindanao, including the 2017 Marawi siege against ISIS-affiliated fighters) to territorial defence in the South China Sea under the Comprehensive Archipelagic Defense Concept. Close US alliance (EDCA sites, Balikatan exercises with HIMARS/NMESIS), Reciprocal Access Agreement with Japan (2024).",
    "squad_size": 9,
    "fireteam": "Rifle squad of 9 in two fireteams with K3/Ultimax and M203; Scout Rangers and Special Forces operate in small teams. Game: 8 in four pairs.",
    "tactics": [
      "Jungle and urban counter-insurgency raids against ISIS-affiliated cells (early-game)",
      "Close-quarters urban clearing learned at Marawi; armour in support (Simba, M113 FSV)",
      "Small-boat and island defence operations, resupply runs to outposts",
      "Air-ground coordination with S-70i, A-29 and T129 helicopters"
    ],
