  "doctrine": {
    "summary": "Militarily neutral since 2007, balancing Russia, China, the EU and NATO (Partnership for Peace) and holding observer status in the CSTO Parliamentary Assembly. Army modernised largely with domestic industry (M-84AS2 tanks, Lazar 3 and Milos MRAPs, Nora B-52 guns) plus Chinese air defence and drones, Russian Mi-35M and French Rafales. Large domestic small-arms industry (Zastava). Contributes to UNIFIL in Lebanon.",
    "squad_size": 9,
    "fireteam": "Squad of 9 in two fireteams; game 8 in pairs.",
    "tactics": [
      "Mountain and wooded defence with strong anti-tank teams",
      "Mounted infantry in Lazar/M-80",
      "Loitering munitions and domestic drones",
      "Peacekeeping posture on UN deployments"
    ],
